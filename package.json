{
  "name": "shipit",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "deploy:cf": "pnpm build && wrangler pages deploy dist --project-name shipit --branch main",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --vitest-plugin --deny-warnings .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "mediabunny": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.3",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  }
}
